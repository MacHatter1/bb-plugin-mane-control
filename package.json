{
  "name": "bb-plugin-mane-control",
  "version": "0.1.2",
  "description": "BB plugin that switches Ponytail between Off, Lite, Full, and Ultra from a horse button beside the thread composer.",
  "license": "MIT",
  "author": "MacHatter1",
  "homepage": "https://github.com/MacHatter1/bb-plugin-mane-control",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacHatter1/bb-plugin-mane-control.git"
  },
  "bugs": {
    "url": "https://github.com/MacHatter1/bb-plugin-mane-control/issues"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "ponytail",
    "ai-agents",
    "developer-tools"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Mane Control",
    "description": "Flips Ponytail between Off, Lite, Full, and Ultra from a horse button beside the composer. Requires the Ponytail skill.",
    "branding": {
      "icon": "./assets/horse-head.svg",
      "experimental_icons": {
        "off": "./assets/horse-off.svg",
        "lite": "./assets/horse-head.svg",
        "full": "./assets/horse.svg",
        "ultra": "./assets/horse-ultra.svg"
      }
    },
    "server": "./src/server.ts",
    "app": "./src/app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.21",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "scripts": {
    "build": "bb plugin build",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types test/server.test.ts"
  }
}
